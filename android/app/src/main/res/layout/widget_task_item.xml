<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Задач пока нет" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_task_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Нажмите, чтобы открыть Планер" android:textColor="@color/widget_muted" android:textSize="10sp" />
</LinearLayout>
